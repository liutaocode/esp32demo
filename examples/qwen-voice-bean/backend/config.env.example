DASHSCOPE_API_KEY=
QWEN_AUDIO_REALTIME_PROVIDER=dashscope
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
AGENT_PROTOCOL=codex
QWEN_AUDIO_AGENT_BACKEND_PERMISSION_MODE=native
HOST=127.0.0.1
PORT=3102
# Generate locally using: openssl rand -base64 32
QWEN_AUDIO_GATEWAY_ACCESS_TOKEN=
# Set absolute paths on your own computer; do not use literal ~ in values.
QWAUDIO_WORKSPACE=
QWEN_AUDIO_AGENT_ASSISTANT_PROFILE_PATH=
CODEX_PATH=
CODEX_ACP_BIN=

# Device ingress listens on LAN port 3101. 0: token-free; 1: token required.
BEAN_DEVICE_REQUIRE_TOKEN=0
